{
  "name": "aiseo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:worker": "tsx watch --env-file-if-exists=.env.local src/worker/index.ts",
    "build": "next build && npm run build:node",
    "build:node": "esbuild worker=src/worker/index.ts migrate=src/server/db/migrate.ts --bundle --platform=node --target=node22 --format=esm --packages=external --outdir=dist",
    "start": "next start",
    "start:worker": "NODE_ENV=production node dist/worker.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env.local src/server/db/migrate.ts",
    "db:migrate:deploy": "NODE_ENV=production node dist/migrate.js",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "@better-auth/stripe": "1.7.7",
    "better-auth": "1.7.7",
    "disposable-email-domains": "1.0.62",
    "drizzle-orm": "0.45.4",
    "next": "16.4.0",
    "pg": "8.23.1",
    "pg-boss": "12.37.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "stripe": "22.6.2",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "railway": "3.12.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.4"
  }
}
