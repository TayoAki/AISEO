# AISEO configuration. Copy to .env.local for development; nothing here is
# required locally except DATABASE_URL (fake providers, console email and
# Cloudflare's test Turnstile keys are used by default outside production).
# In production every value marked [web] or [worker] must be set on that
# Railway service; the service refuses to start otherwise (src/server/env.ts).

# --- Both services -----------------------------------------------------------
DATABASE_URL=postgres://aiseo:aiseo@127.0.0.1:5432/aiseo_dev
# Public https URL of the web service (emails, Stripe redirects, webhook base).
APP_URL=http://localhost:3000
# 32+ random characters; signs Bright Data webhook URLs. `openssl rand -hex 32`
WEBHOOK_SIGNING_SECRET=
# DATABASE_POOL_MAX=10

# --- Web service [web] -------------------------------------------------------
# 32+ random characters; signs sessions and tokens. `openssl rand -hex 32`
BETTER_AUTH_SECRET=
# Header carrying the real client IP behind the platform proxy (rate limits).
TRUSTED_IP_HEADER=x-real-ip
# Cloudflare Turnstile (https://dash.cloudflare.com -> Turnstile). Leave empty
# locally to use Cloudflare's always-pass test keys.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Resend (https://resend.com). Empty locally: emails are printed to the console.
RESEND_API_KEY=
# Must be on your verified Resend domain in production (example.com/localhost are refused).
EMAIL_FROM="AISEO <no-reply@example.com>"
# Stripe. Empty locally: billing pages show "Billing is not configured".
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_PLUS_MONTHLY=
STRIPE_PRICE_PLUS_ANNUAL=
# Comma-separated emails whose verified accounts can open /admin/costs (revenue, costs, margins).
# ADMIN_EMAILS=you@yourdomain.com
# MAX_ACTIVE_REPORTS_PER_USER=3
# Refunded failures caused by a user's input (per 24 h) before their new reports pause.
# MAX_FAILED_REPORTS_PER_DAY=5

# --- Worker service [worker] -------------------------------------------------
# "fake" simulates Bright Data and Claude (default outside production).
# PROVIDER_MODE=fake
ANTHROPIC_API_KEY=
# claude-sonnet-5-5 by default; claude-opus-5-5 thinks harder at about twice the cost.
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_EFFORT=medium
# Server-side refusal fallback (retries a refused request on a fallback model).
ANTHROPIC_REFUSAL_FALLBACK=true
BRIGHTDATA_API_TOKEN=
# Bright Data dataset ids (defaults are the public Perplexity/ChatGPT/Gemini scrapers).
# BRIGHTDATA_DATASET_PERPLEXITY=gd_m7dhdot1vw9a7gc1n
# BRIGHTDATA_DATASET_CHATGPT=gd_m7aof0k82r803d5bjm
# BRIGHTDATA_DATASET_GEMINI=gd_mbz66arm2mf9cu856y
# BRIGHTDATA_CHATGPT_WEB_SEARCH=true
# Your Bright Data price per 1,000 records; only used to report what each report cost.
# BRIGHTDATA_COST_PER_1K_RECORDS=1.5
# WORKER_CONCURRENCY=4
# COLLECTION_TIMEOUT_MINUTES=16
# COLLECTION_MAX_WAIT_MINUTES=45
